{
  "name": "@cryer/star-cli",
  "version": "0.1.0",
  "description": "An AI agent command-line interface",
  "type": "module",
  "license": "MIT",
  "author": "cryer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryer/star-cli.git"
  },
  "homepage": "https://github.com/cryer/star-cli#readme",
  "bugs": "https://github.com/cryer/star-cli/issues",
  "keywords": ["ai", "agent", "cli", "llm", "openai", "anthropic", "terminal"],
  "bin": {
    "star": "./dist/main.js"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pipeline": "node scripts/pipeline.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "pnpm test:pipeline"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.0",
    "@ai-sdk/openai-compatible": "^0.2.0",
    "ai": "^4.3.0",
    "commander": "^13.1.0",
    "ink": "^5.2.0",
    "react": "^18.3.1",
    "smol-toml": "^1.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^1.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
